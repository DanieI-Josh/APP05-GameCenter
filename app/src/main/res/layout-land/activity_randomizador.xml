<?xml version='1.0' encoding='utf-8'?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_screen">
    <androidx.constraintlayout.widget.Guideline android:id="@+id/guiaMetade" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" app:layout_constraintGuide_percent="0.47" />
    <androidx.core.widget.NestedScrollView android:id="@+id/scrollFormulario" android:layout_width="0dp" android:layout_height="0dp" android:fillViewport="false" app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="@id/guiaMetade" app:layout_constraintBottom_toTopOf="@id/layoutNavegacao" android:layout_marginEnd="16dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView style="@style/Etiqueta" android:id="@+id/textTagModulo" android:text="@string/tag_randomizador" android:textColor="@color/rosa" android:layout_marginBottom="4dp" />
            <TextView android:id="@+id/textTitulo" style="@style/Titulo" android:text="@string/randomizador" android:textSize="21sp" android:layout_marginBottom="4dp" />
            <EditText android:id="@+id/editValor" style="@style/Campo" android:hint="@string/valor" android:inputType="textCapSentences" android:maxLength="80" android:singleLine="true" app:backgroundTint="@null" android:layout_marginBottom="8dp" />
            <Spinner android:id="@+id/spinnerCategoria" android:layout_width="match_parent" android:layout_height="48dp" android:background="@drawable/spinner_fundo" android:paddingStart="12dp" android:paddingEnd="36dp" android:layout_marginBottom="8dp" app:backgroundTint="@null" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:baselineAligned="false">
                <Button android:id="@+id/buttonAdicionar" style="@style/Botao" android:text="@string/adicionar" android:layout_width="0dp" android:layout_weight="1" android:layout_marginStart="3dp" android:layout_marginEnd="3dp" />
                <Button android:id="@+id/buttonSortear" style="@style/Botao" android:text="@string/sortear" android:layout_width="0dp" android:layout_weight="1" android:layout_marginStart="3dp" android:layout_marginEnd="3dp" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:baselineAligned="false">
                <Button android:id="@+id/buttonAlternar" style="@style/BotaoSecundario" android:text="@string/exibir_grade" android:layout_width="0dp" android:layout_weight="1" android:layout_marginStart="3dp" android:layout_marginEnd="3dp" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <TextView android:id="@+id/textSorteado" style="@style/Texto" android:text="@string/resultado_vazio" android:accessibilityLiveRegion="polite" android:layout_width="0dp" app:layout_constraintStart_toStartOf="@id/guiaMetade" app:layout_constraintEnd_toEndOf="parent" android:textColor="@color/azul" android:textSize="14sp" android:fontFamily="monospace" android:paddingTop="8dp" android:paddingBottom="4dp" android:layout_marginStart="8dp" app:layout_constraintTop_toTopOf="parent" />
    <TextView android:id="@+id/textQuantidade" style="@style/Texto" android:text="@string/lista_vazia" android:layout_width="0dp" app:layout_constraintTop_toBottomOf="@id/textSorteado" app:layout_constraintStart_toStartOf="@id/guiaMetade" app:layout_constraintEnd_toEndOf="parent" android:textSize="12sp" android:textColor="@color/secundario" android:layout_marginStart="8dp" />
    <TextView android:id="@+id/textVazio" style="@style/Texto" android:layout_width="0dp" android:text="@string/lista_vazia" app:layout_constraintTop_toBottomOf="@id/textQuantidade" app:layout_constraintStart_toStartOf="@id/guiaMetade" app:layout_constraintEnd_toEndOf="parent" android:textSize="14sp" android:textColor="@color/secundario" android:layout_marginStart="8dp" />
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/recyclerOpcoes" android:layout_width="0dp" android:layout_height="0dp" android:clipToPadding="false" app:layout_constraintTop_toBottomOf="@id/textVazio" app:layout_constraintBottom_toTopOf="@id/layoutNavegacao" app:layout_constraintStart_toStartOf="@id/guiaMetade" app:layout_constraintEnd_toEndOf="parent" android:layout_marginStart="8dp" />
    <LinearLayout android:id="@+id/layoutNavegacao" android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="horizontal" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" android:baselineAligned="false">
        <Button android:id="@+id/buttonVoltar" style="@style/BotaoSecundario" android:text="@string/voltar" android:layout_width="0dp" android:layout_weight="1" android:layout_marginStart="3dp" android:layout_marginEnd="3dp" />
        <Button android:id="@+id/buttonEncerrar" style="@style/BotaoSecundario" android:text="@string/encerrar" android:layout_width="0dp" android:layout_weight="1" android:layout_marginStart="3dp" android:layout_marginEnd="3dp" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>