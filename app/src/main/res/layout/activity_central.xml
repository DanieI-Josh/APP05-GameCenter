<?xml version='1.0' encoding='utf-8'?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/scrollConteudo" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingBottom="16dp">
        <TextView android:id="@+id/textTitulo" style="@style/Titulo" android:text="@string/central" />
        <TextView android:id="@+id/textSaudacao" style="@style/Texto" android:text="@string/central" />
        <TextView android:id="@+id/textOrientacao" style="@style/Texto" android:text="@string/orientacao_central" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:minHeight="230dp" android:layout_marginBottom="16dp" android:background="@drawable/painel">
            <ImageView android:id="@+id/imageScanner" android:layout_width="72dp" android:layout_height="72dp" android:src="@drawable/ic_scanner" android:contentDescription="@string/avatar_desc" android:layout_gravity="center_horizontal" android:layout_marginBottom="8dp" />
            <TextView android:id="@+id/textScanner" style="@style/Titulo" android:text="@string/scanner" />
            <TextView android:id="@+id/textDescScanner" style="@style/Texto" android:text="@string/desc_scanner" />
            <Button android:id="@+id/buttonScanner" style="@style/Botao" android:text="@string/abrir" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:minHeight="230dp" android:layout_marginBottom="16dp" android:background="@drawable/painel">
            <ImageView android:id="@+id/imageArena" android:layout_width="72dp" android:layout_height="72dp" android:src="@drawable/ic_arena" android:contentDescription="@string/avatar_desc" android:layout_gravity="center_horizontal" android:layout_marginBottom="8dp" />
            <TextView android:id="@+id/textArena" style="@style/Titulo" android:text="@string/arena" />
            <TextView android:id="@+id/textDescArena" style="@style/Texto" android:text="@string/desc_arena" />
            <Button android:id="@+id/buttonArena" style="@style/Botao" android:text="@string/abrir" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:minHeight="230dp" android:layout_marginBottom="16dp" android:background="@drawable/painel">
            <ImageView android:id="@+id/imageCofre" android:layout_width="72dp" android:layout_height="72dp" android:src="@drawable/ic_cofre" android:contentDescription="@string/avatar_desc" android:layout_gravity="center_horizontal" android:layout_marginBottom="8dp" />
            <TextView android:id="@+id/textCofre" style="@style/Titulo" android:text="@string/cofre" />
            <TextView android:id="@+id/textDescCofre" style="@style/Texto" android:text="@string/desc_cofre" />
            <Button android:id="@+id/buttonCofre" style="@style/Botao" android:text="@string/abrir" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:minHeight="230dp" android:layout_marginBottom="16dp" android:background="@drawable/painel">
            <ImageView android:id="@+id/imageRandomizador" android:layout_width="72dp" android:layout_height="72dp" android:src="@drawable/ic_randomizador" android:contentDescription="@string/avatar_desc" android:layout_gravity="center_horizontal" android:layout_marginBottom="8dp" />
            <TextView android:id="@+id/textRandomizador" style="@style/Titulo" android:text="@string/randomizador" />
            <TextView android:id="@+id/textDescRandomizador" style="@style/Texto" android:text="@string/desc_randomizador" />
            <Button android:id="@+id/buttonRandomizador" style="@style/Botao" android:text="@string/abrir" />
        </LinearLayout>
        <Button android:id="@+id/buttonVoltar" style="@style/Botao" android:text="@string/encerrar" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>